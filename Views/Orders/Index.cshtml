@model IEnumerable<InventoryOrderSystem.Models.Order>

@{
    ViewData["Title"] = "Orders";
}

<h2>Orders</h2>

@if (!Model.Any())
{
    <p>No orders found.</p>
}
else
{
    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>Order Number</th>
                <th>User</th>
                <th>Created Date</th>
                <th>Status</th>
                <th>Total Amount</th>
                <th></th>
            </tr>
        </thead>

        <tbody>
            @foreach (var order in Model)
            {
                <tr>
                    <td>@order.OrderNumber</td>
                    <td>@order.CreatedByUser?.UserName</td>
                    <td>@order.CreatedDate.ToLocalTime().ToString("g")</td>
                    <td>@order.Status</td>
                    <td>@order.TotalAmount.ToString("C")</td>
                    <td>
                        <a asp-action="Details"
                           asp-route-id="@order.Id"
                           class="btn btn-primary btn-sm">
                            Details
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<a asp-controller="Shop" asp-action="Index" class="btn btn-secondary">
    Back to Shop
</a>