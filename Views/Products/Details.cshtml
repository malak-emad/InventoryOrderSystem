@model InventoryOrderSystem.Models.Product

<h2>Product Details</h2>

<div class="mb-3">
    <p><strong>Name:</strong> @Model.Name</p>
    <p><strong>Description:</strong> @Model.Description</p>
    <p><strong>SKU:</strong> @Model.SKU</p>
    <p><strong>Category:</strong> @Model.Category?.Name</p>
    <p><strong>Price:</strong> @Model.Price.ToString("C")</p>
    <p><strong>Quantity in Stock:</strong> @Model.QuantityInStock</p>
    <p><strong>Active:</strong> @Model.IsActive</p>
    <p><strong>Created Date:</strong> @Model.CreatedDate.ToLocalTime().ToString("g")</p>
</div>

<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit</a>
<a asp-action="Index" class="btn btn-secondary">Back to Products</a>