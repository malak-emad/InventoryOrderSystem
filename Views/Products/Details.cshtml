@model InventoryOrderSystem.Models.Product

<h2>Product Details</h2>

<div>
    <p><strong>Name:</strong> @Model.Name</p>

    <p><strong>Description:</strong> @Model.Description</p>

    <p><strong>SKU:</strong> @Model.SKU</p>
    
    <p><strong>Category:</strong> @Model.Category?.Name</p>

    <p><strong>Price:</strong> @Model.Price</p>

    <p><strong>Quantity in Stock:</strong> @Model.QuantityInStock</p>

    <p><strong>Active:</strong> @Model.IsActive</p>

    <p><strong>Created Date:</strong> @Model.CreatedDate</p>
</div>

<a asp-action="Edit" asp-route-id="@Model.Id">Edit</a> |
<a asp-action="Index">Back to Products</a>